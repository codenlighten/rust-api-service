# Copy to .env and export (the service reads the process environment; it does not parse .env itself).
# Required: at least 32 bytes. Generate one with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
# Optional (defaults shown)
DATABASE_URL=sqlite://notes.sqlite?mode=rwc
BIND_ADDR=127.0.0.1:3000
TOKEN_TTL_SECS=3600
DB_MAX_CONNECTIONS=8
RUST_LOG=info
# Set to "json" for one JSON object per log line
LOG_FORMAT=text
